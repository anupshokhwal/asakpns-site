{
  // Cloudflare Worker: serves the website in ./public and handles the
  // contact form at /api/contact (src/index.js).
  "name": "asakpns",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker before serving files, so www.asakpns.com can be
    // redirected to asakpns.com (src/index.js).
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Not secret. Secrets (TURNSTILE_SECRET, SMTP_PASSWORD) are set in the
  // Cloudflare dashboard under Settings -> Variables and Secrets.
  "vars": {
    "TURNSTILE_HOSTNAMES": "asakpns.com,www.asakpns.com",
    "SMTP_HOST": "smtp.migadu.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "hello@asakpns.com",
    "CONTACT_TO": "hello@asakpns.com"
  }
}
